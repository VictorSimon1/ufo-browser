{
  "name": "ufo-browser",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "author": "VictorSimon1",
  "description": "A high-performance local-first Chromium browser built for AI agents and people.",
  "main": "dist/main/electron.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js scripts/sync-agent-skills.test.mjs",
    "test:app": "npm run build && UFO_BROWSER_TEST_APP=1 electron .",
    "test:app:reuse": "UFO_BROWSER_TEST_APP=1 electron .",
    "test:app:stop": "node scripts/stop-test-app.mjs",
    "verify:page-layout": "npm run build && node --test dist/tests/layout.test.js",
    "verify:multi-agent": "npm run build && node --test dist/tests/space-lease.test.js",
    "verify:preview": "npm run build && node --test dist/tests/preview-visibility.test.js",
    "verify:preview-startup": "npm run build && node scripts/preview-startup-e2e.mjs",
    "verify:restart-restore": "npm run build && node scripts/restart-restore-e2e.mjs",
    "verify:warm-entry": "npm run build && node scripts/warm-space-entry-e2e.mjs",
    "verify:restart-scale": "npm run build && node scripts/restart-scale-e2e.mjs",
    "verify:live-preview": "npm run build && node scripts/live-preview-e2e.mjs",
    "verify:space-ui": "npm run build && node scripts/space-ui-e2e.mjs",
    "verify:temporary-profile": "npm run build && node scripts/temporary-profile-e2e.mjs",
    "verify:browser-interaction": "npm run build && node scripts/browser-interaction-e2e.mjs",
    "verify:control-ui": "npm run build && node scripts/control-ui-e2e.mjs",
    "verify:agent-initial-tab": "npm run build && node scripts/agent-initial-tab-e2e.mjs",
    "verify:agent-focus-isolation": "npm run build && node scripts/agent-focus-isolation-e2e.mjs",
    "verify:energy-budget": "npm run build && node scripts/agent-surface-budget-e2e.mjs",
    "verify:helper-parity": "npm run build && node scripts/helper-parity-e2e.mjs",
    "verify:locator-reliability": "npm run build && node scripts/locator-reliability-e2e.mjs",
    "verify:window-lifecycle": "npm run build && node scripts/window-lifecycle-e2e.mjs",
    "verify:app-quit": "npm run build && node scripts/app-quit-e2e.mjs",
    "verify:popup-download": "npm run build && node scripts/popup-download-e2e.mjs",
    "verify:fingerprint": "npm run build && node scripts/fingerprint-parity-e2e.mjs",
    "verify:janitor": "npm run build && node scripts/janitor-turnstile-e2e.mjs",
    "verify:chrome-import": "npm run build && node scripts/chrome-import-e2e.mjs success",
    "verify:chrome-import-restart": "npm run build && node scripts/chrome-import-e2e.mjs restart",
    "verify:profile-sync": "npm run build && node scripts/chrome-import-e2e.mjs sync",
    "verify:chrome-import-rollback": "npm run build && node scripts/chrome-import-e2e.mjs rollback",
    "cli:install:local": "npm run build && node scripts/install-local-cli.mjs",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "skills:sync:dry-run": "node scripts/sync-agent-skills.mjs --dry-run",
    "install:mac": "node scripts/install-mac.mjs",
    "verify:skill-sync": "node --test scripts/sync-agent-skills.test.mjs",
    "dist:mac": "node scripts/package-mac.mjs --dir",
    "package:mac:test": "node scripts/package-mac.mjs --temporary",
    "package:mac": "node scripts/package-mac.mjs --release",
    "release:mac": "npm run package:mac",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.8",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.ufobrowser.app",
    "productName": "UFO-Browser",
    "asar": true,
    "asarUnpack": [
      "dist/bin/**/*",
      "dist/agent/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "skills/ufo-browser",
        "to": "skills/ufo-browser"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "dmg": {
      "title": "UFO-Browser ${version}",
      "iconSize": 128,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file",
          "name": "UFO-Browser.app"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
